BootStrap: docker
From: python:3.13-slim

%labels
    Maintainer Robert A. Mostoghiu Paun
    Description SAGE Universal Merger Tree Converter runtime image

%files
    pyproject.toml /tmp/pyproject.toml

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y --no-install-recommends \
        curl \
        git \
        hdf5-tools

    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
    apt-get install -y --no-install-recommends nodejs

    npm install -g @anthropic-ai/claude-code @openai/codex

    # agy (Antigravity CLI) is a native binary; move to /usr/local/bin for PATH stability.
    curl -fsSL https://antigravity.google/cli/install.sh | bash
    mv ~/.local/bin/agy /usr/local/bin/agy

    for uid in 501 502 1000 1001; do
        grep -q ":${uid}:" /etc/passwd || \
        echo "user${uid}:x:${uid}:${uid}::/tmp:/bin/sh" >> /etc/passwd
    done

    git config --system safe.directory '*'
    python3 -c "import tomllib; d=tomllib.loads(open('/tmp/pyproject.toml','rb').read()); deps=d['project']['dependencies']; import subprocess,sys; subprocess.check_call([sys.executable,'-m','pip','install','--no-cache-dir']+deps)"

    rm -rf /var/lib/apt/lists/* /tmp/pyproject.toml

%environment
    export HOME=/tmp
    export MPLCONFIGDIR=/tmp/matplotlib
    export PS1='sage-sandbox:\w\$ '

%runscript
    if [ "$#" -eq 0 ]; then
        exec /bin/bash
    fi
    exec "$@"
