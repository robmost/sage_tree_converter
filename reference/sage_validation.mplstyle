# SAGE merger tree converter — validation plot style
# Applied via plt.style.use('reference/sage_validation.mplstyle')
# Default layout: 1x3 grid (12 x 4 inches). For 3x3 grids, override figsize in the script.

# --- Figure ---
figure.figsize        : 12, 4
figure.constrained_layout.use : True

# --- Fonts ---
font.family           : sans-serif
font.size             : 11
axes.titlesize        : 12
axes.labelsize        : 11
xtick.labelsize       : 9
ytick.labelsize       : 9
legend.fontsize       : 9

# --- Colour cycle (7 distinct colours, colour-blind friendly) ---
axes.prop_cycle       : cycler('color', ['1f77b4', 'ff7f0e', '2ca02c', 'd62728', '9467bd', '8c564b', 'e377c2'])

# --- Grid ---
axes.grid             : True
grid.linestyle        : --
grid.alpha            : 0.4
grid.color            : 999999

# --- Lines and markers ---
lines.linewidth       : 1.5
lines.markersize      : 4

# --- Axes ---
axes.spines.top       : False
axes.spines.right     : False

# --- Save ---
savefig.dpi           : 150
savefig.format        : pdf
savefig.bbox          : tight
