# =============================================================================
# LLM API Keys
# =============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Antigravity CLI (agy) uses OAuth — no API key required. Run `agy` once to authenticate
# via your browser (local) or the printed URL flow (SSH / container).
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# External Data Mounts (Optional)
# =============================================================================
# Specify absolute paths to override the default ./input and ./output directories.
# Useful when running on a supercomputer where data lives outside the project root.
# These values are used by both Docker volume mounts and Apptainer bind mounts.
# If left commented or blank, defaults to the local ./input and ./output directories.
# INPUT_DIR=/path/to/your/external/input
# OUTPUT_DIR=/path/to/your/external/output

# =============================================================================
# SAGE Binary (Optional)
# =============================================================================
# Absolute path to a locally compiled SAGE binary.
# If set, Stage 2 functional validation will run a SAGE dry run on the test output.
# If not set, functional validation is skipped.
# SAGE_BINARY_PATH=/path/to/sage/binary
# Docker users: also set SAGE_BINARY_DIR to the directory containing the binary
# and uncomment the matching volume line in container/docker-compose.yml.
# SAGE_BINARY_DIR=/path/to/sage/build

# =============================================================================
# Tuning Parameters
# =============================================================================
# Memory multiplier used to estimate peak memory from input file size.
# The LLM will warn the user before Stage 2 if the estimated memory requirement
# exceeds the container's available memory. Increase this value if conversions
# are failing due to out-of-memory errors. Default is 3.0.
SAGE_MEMORY_MULTIPLIER=3.0

# =============================================================================
# Python Interpreter
# =============================================================================
# Python interpreter used for all shell-context invocations (conversion scripts,
# validation scripts, JSON checks). Default is python3, which is correct when
# running inside the Docker or Apptainer container.
# When running directly from a native shell (outside the container), set this to
# the full path of your Anaconda/conda environment Python to ensure h5py and other
# packages are found correctly. Example:
# PYTHON_BIN=/opt/anaconda3/bin/python
PYTHON_BIN=python3
